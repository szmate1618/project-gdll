# Multiplayer fingerprints hash raw bytes, including line endings. Keep LF so
# Windows CRLF conversion cannot make matching content fail the Linux handshake.
/items/*.toml text eol=lf
/inventory.toml text eol=lf
/forest_patches.json text eol=lf
/forest_patches_astra.json text eol=lf
/assets/zombies/models/*.hitboxes.json text eol=lf
/assets/zombies/models/*.capsules.json text eol=lf
# Unix launchers need LF for the interpreter shebang.
/multiplayer/linux/run-client.sh text eol=lf

# Preserve the pinned upstream source and license bytes, including whitespace.
third_party/recastnavigation/** -text -whitespace
