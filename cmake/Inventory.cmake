# Item definitions and player storage have no graphics dependencies.
add_library(viewer_items STATIC src/inventory/item.cpp src/inventory/item_config.cpp)
target_include_directories(viewer_items PUBLIC "${PROJECT_SOURCE_DIR}/src")
target_link_libraries(viewer_items PUBLIC viewer_weapon_config PRIVATE tomlplusplus::tomlplusplus)
viewer_warnings(viewer_items)
add_library(viewer_storage STATIC src/inventory/storage_config.cpp)
target_include_directories(viewer_storage PUBLIC "${PROJECT_SOURCE_DIR}/src")
target_link_libraries(viewer_storage PRIVATE tomlplusplus::tomlplusplus)
viewer_warnings(viewer_storage)
add_library(viewer_inventory STATIC src/inventory/player_inventory.cpp src/inventory/inventory_config.cpp
    src/inventory/inventory_placement.cpp src/inventory/inventory_drag.cpp)
target_link_libraries(viewer_inventory PUBLIC viewer_items viewer_storage PRIVATE tomlplusplus::tomlplusplus)
viewer_warnings(viewer_inventory)
if(BUILD_TESTING)
    add_executable(test_player_inventory tests/test_player_inventory.cpp)
    target_link_libraries(test_player_inventory PRIVATE viewer_inventory)
    target_compile_definitions(test_player_inventory PRIVATE VIEWER_ITEM_ROOT="${PROJECT_SOURCE_DIR}")
    viewer_warnings(test_player_inventory)
    add_test(NAME viewer_player_inventory COMMAND test_player_inventory)
    add_executable(test_inventory_placement tests/test_inventory_placement.cpp)
    target_link_libraries(test_inventory_placement PRIVATE viewer_inventory)
    target_compile_definitions(test_inventory_placement PRIVATE VIEWER_ITEM_ROOT="${PROJECT_SOURCE_DIR}")
    viewer_warnings(test_inventory_placement)
    add_test(NAME viewer_inventory_placement COMMAND test_inventory_placement)
    add_executable(test_inventory_drag tests/test_inventory_drag.cpp)
    target_link_libraries(test_inventory_drag PRIVATE viewer_inventory)
    target_compile_definitions(test_inventory_drag PRIVATE VIEWER_ITEM_ROOT="${PROJECT_SOURCE_DIR}")
    viewer_warnings(test_inventory_drag)
    add_test(NAME viewer_inventory_drag COMMAND test_inventory_drag)
    add_executable(test_item_config tests/test_item_config.cpp)
    target_link_libraries(test_item_config PRIVATE viewer_inventory)
    target_compile_definitions(test_item_config PRIVATE VIEWER_ITEM_ROOT="${PROJECT_SOURCE_DIR}")
    viewer_warnings(test_item_config)
    add_test(NAME viewer_item_config COMMAND test_item_config)
    add_executable(test_storage_config tests/test_storage_config.cpp)
    target_link_libraries(test_storage_config PRIVATE viewer_storage)
    target_compile_definitions(test_storage_config PRIVATE VIEWER_STORAGE_DIR="${PROJECT_SOURCE_DIR}/storage")
    viewer_warnings(test_storage_config)
    add_test(NAME viewer_storage_config COMMAND test_storage_config)
endif()
