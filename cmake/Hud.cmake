# Keep graphics-only UI dependencies out of dedicated/headless server builds.
function(gd_add_hud)
    set(BUILD_SHARED_LIBS OFF)
    find_package(Freetype QUIET)
    if(NOT TARGET Freetype::Freetype)
        set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
        FetchContent_Declare(freetype
            URL https://codeload.github.com/freetype/freetype/tar.gz/refs/tags/VER-2-13-3
            URL_HASH SHA256=bc5c898e4756d373e0d991bab053036c5eb2aa7c0d5c67e8662ddc6da40c4103
            DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/_archives"
            DOWNLOAD_NAME freetype-2.13.3.tar.gz)
        FetchContent_MakeAvailable(freetype)
        add_library(Freetype::Freetype ALIAS freetype)
    endif()
    set(RMLUI_SAMPLES OFF CACHE BOOL "" FORCE)
    set(RMLUI_LUA_BINDINGS OFF CACHE BOOL "" FORCE)
    set(RMLUI_SVG_PLUGIN OFF CACHE BOOL "" FORCE)
    set(RMLUI_LOTTIE_PLUGIN OFF CACHE BOOL "" FORCE)
    set(RMLUI_IME_SAMPLE_USE_NOTO_FONTS OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(rmlui
        URL https://codeload.github.com/mikke89/RmlUi/tar.gz/refs/tags/6.3
        URL_HASH SHA256=d977298bb6147610e5984d5db85ddf284020d655a8713913f6982074f1dbdede
        DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/_archives"
        DOWNLOAD_NAME rmlui-6.3.tar.gz)
    FetchContent_MakeAvailable(rmlui)

    add_library(viewer_minimap STATIC src/minimap.cpp src/minimap_roads.cpp)
    target_link_libraries(viewer_minimap PUBLIC viewer_model viewer_visibility)
    viewer_warnings(viewer_minimap)
    if(BUILD_TESTING)
        add_executable(test_minimap tests/test_minimap.cpp)
        target_link_libraries(test_minimap PRIVATE viewer_minimap)
        viewer_warnings(test_minimap)
        add_test(NAME viewer_minimap COMMAND test_minimap)
        add_executable(test_minimap_roads tests/test_minimap_roads.cpp)
        target_link_libraries(test_minimap_roads PRIVATE viewer_minimap)
        viewer_warnings(test_minimap_roads)
        add_test(NAME viewer_minimap_roads COMMAND test_minimap_roads)
    endif()
    add_library(viewer_items STATIC src/item_config.cpp)
    target_include_directories(viewer_items PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(viewer_items PRIVATE tomlplusplus::tomlplusplus)
    viewer_warnings(viewer_items)
    add_library(viewer_storage STATIC src/storage_config.cpp)
    target_include_directories(viewer_storage PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(viewer_storage PRIVATE tomlplusplus::tomlplusplus)
    viewer_warnings(viewer_storage)
    add_library(viewer_inventory_placement STATIC src/inventory_placement.cpp)
    target_link_libraries(viewer_inventory_placement PUBLIC viewer_items viewer_storage)
    viewer_warnings(viewer_inventory_placement)
    if(BUILD_TESTING)
        add_executable(test_inventory_placement tests/test_inventory_placement.cpp)
        target_link_libraries(test_inventory_placement PRIVATE viewer_inventory_placement)
        target_compile_definitions(test_inventory_placement PRIVATE VIEWER_ITEM_ROOT="${PROJECT_SOURCE_DIR}")
        viewer_warnings(test_inventory_placement)
        add_test(NAME viewer_inventory_placement COMMAND test_inventory_placement)
        add_executable(test_item_config tests/test_item_config.cpp)
        target_link_libraries(test_item_config PRIVATE viewer_items)
        target_compile_definitions(test_item_config PRIVATE VIEWER_ITEM_ROOT="${PROJECT_SOURCE_DIR}")
        viewer_warnings(test_item_config)
        add_test(NAME viewer_item_config COMMAND test_item_config)
        add_executable(test_storage_config tests/test_storage_config.cpp)
        target_link_libraries(test_storage_config PRIVATE viewer_storage)
        target_compile_definitions(test_storage_config PRIVATE VIEWER_STORAGE_DIR="${PROJECT_SOURCE_DIR}/storage")
        viewer_warnings(test_storage_config)
        add_test(NAME viewer_storage_config COMMAND test_storage_config)
    endif()
    add_library(viewer_hud STATIC src/hud.cpp src/hud_render_interface.cpp src/minimap_road_renderer.cpp src/inventory_view.cpp)
    target_include_directories(viewer_hud PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(viewer_hud PUBLIC viewer_minimap PRIVATE RmlUi::Core viewer_renderer viewer_storage viewer_items viewer_inventory_placement)
    target_compile_definitions(viewer_hud PRIVATE GL_GLEXT_PROTOTYPES)
    if(WIN32)
        target_link_libraries(viewer_hud PRIVATE GLEW::GLEW)
    endif()
    viewer_warnings(viewer_hud)
endfunction()
gd_add_hud()
