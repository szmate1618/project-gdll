<template name="loadout" content="page-content">
<head>
    <link type="text/rcss" href="hud.rcss" />
    <link type="text/rcss" href="loadout.rcss" />
    <link type="text/rcss" href="palette.rcss" />
</head>
<body>
    <div id="loadout-frame">
        <div id="loadout-header">
            <button id="inventory-tab" class="page-tab"><span class="key-label">F1</span>INVENTORY</button>
            <button id="skills-tab" class="page-tab"><span class="key-label">F2</span>SKILLS</button>
            <button id="health-tab" class="page-tab"><span class="key-label">F3</span>HEALTH</button>
            <button id="map-tab" class="page-tab"><span class="key-label">F4</span>MAP</button>
            <div class="close-hint">Press the active key or Esc to close</div>
        </div>
        <div id="page-content"></div>
        <div id="action-hotbar" class="panel">
            <div class="panel-heading">ACTION SHORTCUTS</div>
            <div id="hotbar-slots"></div>
        </div>
    </div>
</body>
</template>
