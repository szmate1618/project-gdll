#sleep-drawer {
    display: none; position: absolute; right: -330dp; top: 24%;
    width: 364dp; height: 92dp; z-index: 35;
}
#sleep-drawer.available { display: block; }
#sleep-drawer.expanded { right: 0dp; top: 22%; height: 422dp; }
#sleep-tab {
    position: absolute; left: 0dp; top: 0dp; width: 32dp; height: 92dp;
    background-color: #2b2d2ff2; border: 1dp #f5f6f24d;
    color: #f5f6f2; font-size: 12dp; text-align: center; line-height: 14dp; padding-top: 10dp;
    box-sizing: border-box;
}
#sleep-tab.pending { background-color: #383a3c; border-color: #ec6962; color: #f5f6f2; }
#sleep-tab.hovered { background-color: #4b4d4f; border-color: #f5f6f2bf; }
#sleep-drawer.expanded #sleep-tab { background-color: #383a3cfa; border-left-color: #ec6962; }
#sleep-panel {
    position: absolute; left: 34dp; top: 0dp; width: 330dp; height: 100%;
    background-color: #383a3cfa; color: #f5f6f2; border-left: 1dp #f5f6f24d;
}
.sleep-heading { position: absolute; left: 18dp; top: 16dp; font-size: 12dp; letter-spacing: 2dp; }
#sleep-close { position: absolute; right: 12dp; top: 10dp; width: 28dp; height: 28dp; line-height: 26dp; font-size: 18dp; }
.sleep-clock-row { position: absolute; left: 18dp; top: 49dp; right: 18dp; height: 40dp; }
#sleep-day { position: absolute; left: 0dp; top: 14dp; color: #f5f6f299; font-size: 11dp; }
#sleep-clock { position: absolute; right: 0dp; top: 0dp; font-size: 32dp; }
.sleep-rule { position: absolute; left: 18dp; right: 18dp; top: 100dp; height: 1dp; background-color: #f5f6f226; }
.sleep-duration-label { position: absolute; left: 18dp; top: 114dp; font-size: 10dp; color: #f5f6f299; }
.sleep-stepper { position: absolute; top: 134dp; left: 18dp; right: 18dp; height: 48dp; }
#sleep-duration { position: absolute; left: 54dp; right: 54dp; top: 0dp; line-height: 46dp; text-align: center; font-size: 30dp; }
#sleep-less, #sleep-more { position: absolute; top: 0dp; width: 44dp; height: 46dp; line-height: 44dp; font-size: 24dp; }
#sleep-less { left: 0dp; }
#sleep-more { right: 0dp; }
#sleep-wake { position: absolute; top: 192dp; left: 18dp; right: 18dp; font-size: 11dp; text-align: center; color: #f5f6f2bf; }
#sleep-suggest { position: absolute; top: 219dp; left: 18dp; right: 18dp; height: 36dp; line-height: 34dp; }
#sleep-proposal { position: absolute; top: 269dp; left: 18dp; right: 18dp; font-size: 12dp; }
#sleep-roster { position: absolute; top: 291dp; left: 18dp; right: 18dp; height: 54dp; overflow-y: auto; font-size: 10dp; }
.sleep-member { height: 17dp; color: #f5f6f299; }
.sleep-member span { float: right; }
.sleep-member.accept, .sleep-member.guard { color: #f5f6f2; }
#sleep-roster scrollbarvertical { width: 8dp; margin-left: 4dp; }
#sleep-roster scrollbarvertical slidertrack { background-color: #2b2d2f; }
#sleep-roster scrollbarvertical sliderbar { min-height: 16dp; background-color: #f5f6f280; }
#sleep-roster scrollbarvertical sliderbar:hover { background-color: #f5f6f2bf; }
#sleep-roster scrollbarvertical sliderarrowdec, #sleep-roster scrollbarvertical sliderarrowinc { height: 0dp; }
.sleep-responses { position: absolute; top: 352dp; left: 18dp; right: 18dp; height: 30dp; }
#sleep-accept { position: absolute; left: 0dp; width: 142dp; height: 30dp; }
#sleep-guard { position: absolute; right: 0dp; width: 142dp; height: 30dp; }
#sleep-cancel { position: absolute; top: 388dp; left: 18dp; right: 18dp; height: 22dp; line-height: 20dp; font-size: 10dp; }
.sleep-button {
    box-sizing: border-box; display: block; text-align: center; line-height: 28dp;
    background-color: #2b2d2f; border: 1dp #f5f6f24d;
    color: #f5f6f2; font-size: 12dp; padding: 0dp 5dp;
}
.sleep-button.hovered { background-color: #4b4d4f; border-color: #f5f6f2bf; }
.sleep-button.primary { background-color: #f5f6f2; border-color: #f5f6f2; color: #2b2d2f; }
.sleep-button.primary.hovered { background-color: #d7dad4; }
.sleep-button.selected { background-color: #4b4d4f; border-bottom-color: #ec6962; color: #f5f6f2; }
.sleep-button.disabled { opacity: .35; }
#sleep-notice {
    display: none; position: absolute; right: 54dp; top: 22%; width: 330dp; height: 183dp;
    box-sizing: border-box; padding: 16dp; z-index: 34;
    background-color: #383a3cfa; border: 1dp #f5f6f24d; border-top: 2dp #ec6962;
    color: #f5f6f2;
}
#sleep-notice.visible { display: block; }
.sleep-notice-title { font-size: 10dp; letter-spacing: 2dp; color: #f5f6f2bf; }
#sleep-notice-text { margin-top: 9dp; font-size: 15dp; }
#sleep-notice-wake { margin-top: 6dp; font-size: 11dp; color: #f5f6f299; }
#sleep-notice-accept, #sleep-notice-guard { position: absolute; top: 92dp; width: 142dp; height: 30dp; }
#sleep-notice-accept { left: 16dp; }
#sleep-notice-guard { right: 16dp; }
#sleep-notice-another { position: absolute; left: 16dp; right: 16dp; top: 128dp; height: 28dp; line-height: 26dp; }
.sleep-notice-hint { position: absolute; left: 16dp; bottom: 6dp; font-size: 9dp; color: #f5f6f299; }
.sleep-expanded #equipment-drawer { top: 81%; height: 136dp; transition: none; }
#sleep-blackout { display: none; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; background-color: #000; z-index: 200; }
.sleeping > div { display: none; }
.sleeping #sleep-blackout { display: block; }
#sleep-blackout-content { position: absolute; left: 50%; top: 50%; margin-left: -180dp; margin-top: -120dp; width: 360dp; height: 240dp; text-align: center; color: #f5f6f2; }
.sleep-blackout-title { font-size: 11dp; letter-spacing: 4dp; }
#sleep-rest-clock { margin-top: 18dp; font-size: 48dp; }
#sleep-rest-day { margin-top: 5dp; font-size: 11dp; }
#sleep-rest-remaining { margin-top: 22dp; font-size: 14dp; }
#sleep-rest-rate { margin-top: 8dp; font-size: 11dp; color: #f5f6f299; }
#sleep-rest-wake { position: absolute; top: 194dp; left: 100dp; width: 160dp; height: 32dp; line-height: 30dp; }
#sleep-rest-sleep { display: none; position: absolute; top: 194dp; left: 25dp; width: 150dp; height: 32dp; line-height: 30dp; }
.guarding #sleep-rest-sleep { display: block; }
.guarding #sleep-rest-wake { left: 185dp; width: 150dp; }
.sleep-rest-hint { position: absolute; top: 238dp; width: 100%; font-size: 9dp; color: #f5f6f299; }
#sleep-wake-notice { position: absolute; top: 100dp; left: 50%; width: 420dp; margin-left: -210dp; text-align: center; color: #f5f6f2; font-size: 14dp; }
#sleep-wake-reason { line-height: 20dp; }
#sleep-wake-status { margin-top: 10dp; font-size: 11dp; color: #f5f6f299; }
