<rml>
<head><title>Skills</title><link type="text/template" href="loadout.rml" /></head>
<body template="loadout" class="loadout skills">
    <div id="skills-list" class="panel main-panel">
        <div class="panel-heading">AVAILABLE ACTIONS</div>
        <div id="melee-skills" class="skills-group">
            <div class="skills-group-heading">MELEE SKILLS</div>
            <div id="melee-skill-entries"></div>
        </div>
        <div id="saved-combos" class="skills-group">
            <div class="skills-group-heading">SAVED COMBOS</div>
            <div class="skills-empty">No saved combos</div>
        </div>
    </div>
    <div id="combo-builder" class="panel main-panel">
        <div class="panel-heading">COMBO BUILDER</div><div class="panel-meta">0 / 6 ACTIONS</div>
        <div id="combo-slots">
            <div class="combo-slot"><div class="combo-number">1</div><div class="combo-add"><span>+</span> Add next skill</div></div>
            <div class="combo-arrow">&#8595;</div>
            <div class="combo-slot"><div class="combo-number">2</div><div class="combo-add"><span>+</span> Add next skill</div></div>
            <div class="combo-arrow">&#8595;</div>
            <div class="combo-slot"><div class="combo-number">3</div><div class="combo-add"><span>+</span> Add next skill</div></div>
            <div class="combo-arrow">&#8595;</div>
            <div class="combo-slot"><div class="combo-number">4</div><div class="combo-add"><span>+</span> Add next skill</div></div>
            <div class="combo-arrow">&#8595;</div>
            <div class="combo-slot"><div class="combo-number">5</div><div class="combo-add"><span>+</span> Add next skill</div></div>
            <div class="combo-arrow">&#8595;</div>
            <div class="combo-slot"><div class="combo-number">6</div><div class="combo-add"><span>+</span> Add next skill</div></div>
        </div>
    </div>
    <div id="combo-details" class="panel main-panel">
        <div class="panel-heading">COMBO DETAILS</div>
        <button id="save-combo" disabled="disabled">Save Combo</button>
    </div>
</body>
</rml>
