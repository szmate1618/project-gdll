body.loadout { pointer-events: auto; }
#loadout-frame { position: absolute; left: 50%; top: 50%; margin-left: -606dp; margin-top: -330dp; width: 1212dp; height: 660dp; }
#loadout-header { position: absolute; top: 0dp; width: 1212dp; height: 48dp; border-bottom-width: 1dp; }
.page-tab { display: block; position: absolute; top: 6dp; height: 40dp; width: 178dp; box-sizing: border-box; padding: 0dp; text-align: left; font-size: 19dp; cursor: pointer; }
#inventory-tab { left: 0dp; }
#skills-tab { left: 204dp; }
#health-tab { left: 408dp; }
#map-tab { left: 612dp; }
.key-label { display: inline-block; width: 28dp; font-size: 11dp; }
.inventory #inventory-tab, .skills #skills-tab, .health #health-tab, .map #map-tab { border-bottom-width: 2dp; }
.close-hint { position: absolute; right: 0dp; top: 12dp; font-size: 11dp; }
.panel { position: absolute; border-width: 1dp; }
.main-panel { box-sizing: content-box; top: 68dp; height: 450dp; }
.panel-heading { position: absolute; left: 20dp; top: 17dp; font-size: 12dp; letter-spacing: 2dp; }
.panel-meta { position: absolute; right: 20dp; top: 18dp; font-size: 10dp; }
#body-storage { left: 0dp; width: 388dp; }
#backpack { left: 408dp; width: 428dp; }
.details-panel { left: 856dp; width: 354dp; }
.backpack-size { font-size: 14dp; top: 14dp; }
/* Slot coordinates use this inner rectangle of each panel, in design dp. */
.storage-area { position: absolute; left: 20dp; top: 62dp; height: 344dp; }
#body-storage-slots { width: 348dp; }
#backpack-storage { width: 388dp; }
.storage-slot { position: absolute; width: 108dp; }
.storage-label { height: 28dp; font-size: 10dp; line-height: 12dp; overflow: hidden; }
.storage-row { display: flex; }
.storage-grid { position: relative; }
.storage-item { position: absolute; box-sizing: border-box; border-width: 1dp; overflow: hidden; }
.storage-item-label { padding: 2dp; }
.storage-item-quantity { position: absolute; right: 1dp; bottom: 0dp; font-size: 10dp; line-height: 12dp; }
.storage-occupants { height: 14dp; padding-top: 3dp; font-size: 9dp; white-space: nowrap; overflow: hidden; }
.storage-cell { flex: 1; min-width: 0dp; box-sizing: border-box; border-width: 1dp; }
.storage-time { padding-top: 7dp; font-size: 10dp; }
.main-storage { position: absolute; }
.storage-empty { position: absolute; top: 300dp; width: 100%; text-align: center; font-size: 10dp; }
.backpack-access { position: absolute; bottom: 28dp; width: 428dp; text-align: center; font-size: 10dp; }
.backpack-caption { position: absolute; bottom: 8dp; width: 428dp; text-align: center; font-size: 9dp; }
.detail-square { position: absolute; left: 20dp; top: 66dp; width: 42dp; height: 42dp; }
.detail-name { position: absolute; left: 80dp; top: 61dp; font-size: 24dp; }
.detail-subtitle { position: absolute; left: 80dp; top: 98dp; font-size: 10dp; }
.detail-fields { position: absolute; left: 20dp; top: 140dp; width: 314dp; }
.detail-field { height: 47dp; padding-top: 3dp; border-top-width: 1dp; }
.field-label { margin-top: 5dp; font-size: 9dp; letter-spacing: 1dp; }
.field-value { margin-top: 7dp; font-size: 13dp; }
#action-hotbar { bottom: 0dp; left: 0dp; width: 1210dp; height: 120dp; }
#action-hotbar .panel-heading { top: 12dp; font-size: 11dp; }
#hotbar-slots { display: flex; position: absolute; left: 19dp; top: 43dp; width: 1172dp; height: 62dp; }
.action-slot { position: relative; flex: 1; min-width: 0dp; height: 60dp; margin-right: 8dp; border-width: 1dp; }
.action-slot.last { margin-right: 0dp; }
.action-number { position: absolute; left: 8dp; top: 6dp; font-size: 11dp; }
.assignment-type { position: absolute; right: 8dp; top: 8dp; font-size: 8dp; letter-spacing: 1dp; }
.assignment-square { position: absolute; left: 8dp; top: 33dp; width: 14dp; height: 14dp; }
.assignment-name { position: absolute; left: 29dp; right: 5dp; top: 30dp; font-size: 11dp; line-height: 13dp; }
.empty .assignment-name { left: 8dp; font-size: 10dp; }
.health #action-hotbar, .map #action-hotbar { display: none; }
.full-panel { left: 0dp; width: 1210dp; height: 590dp; }
#satellite-overview { display: block; position: absolute; left: 50%; margin-left: -257dp; top: 54dp; width: 512dp; height: 512dp; border-width: 1dp; }
#map-unavailable { position: absolute; left: 0dp; top: 298dp; width: 1210dp; text-align: center; font-size: 13dp; }
#map-tools { display: none; position: absolute; left: 20dp; top: 54dp; width: 300dp; }
.has-satellite #map-tools { display: block; }
#map-tools button { display: block; width: 280dp; height: 34dp; box-sizing: border-box; margin-bottom: 8dp; font-family: hud-system; font-size: 11dp; line-height: 32dp; border-width: 1dp; border-left-width: 2dp; text-align: center; cursor: pointer; }
#map-total { margin-top: 18dp; font-size: 12dp; line-height: 22dp; }
#map-preview-total { font-size: 12dp; line-height: 22dp; }
#map-player-label { margin-top: 18dp; font-size: 12dp; }
#map-hint { position: absolute; left: 20dp; right: 20dp; bottom: 7dp; font-size: 10dp; text-align: center; }
.map-distance-label { position: absolute; height: 18dp; font-size: 10dp; line-height: 18dp; text-align: center; pointer-events: none; }
#satellite-overview { overflow: hidden; }
.has-satellite #map-unavailable { display: none; }

.inventory-ghost { position: absolute; z-index: 100; box-sizing: border-box; border-width: 2dp; pointer-events: none; overflow: hidden; font-size: 9dp; }
.inventory-placement-progress { position: absolute; z-index: 101; width: 132dp; height: 30dp; pointer-events: none; }
.placement-track { width: 130dp; height: 6dp; border-width: 1dp; }
.placement-fill { height: 6dp; }
.placement-label { padding-top: 4dp; font-size: 9dp; }

/* Equal halves of the right column, separated by a narrow gutter. */
.inventory .details-panel { height: 220dp; overflow: hidden; }
.inventory .detail-square { left: 16dp; top: 47dp; width: 26dp; height: 26dp; }
.inventory .detail-name { left: 52dp; right: 12dp; top: 44dp; font-size: 16dp; white-space: nowrap; overflow: hidden; }
.inventory .detail-subtitle { left: 16dp; top: 80dp; font-size: 9dp; }
.inventory .detail-fields { left: 16dp; top: 103dp; width: 322dp; display: flex; flex-wrap: wrap; }
.inventory .detail-field { box-sizing: border-box; width: 50%; height: 36dp; padding-top: 0dp; overflow: hidden; }
.inventory .field-label { margin-top: 3dp; font-size: 8dp; }
.inventory .field-value { margin-top: 2dp; font-size: 10dp; white-space: nowrap; }
#ground-panel { left: 856dp; top: 298dp; width: 354dp; height: 220dp; }
#ground-scroll { position: absolute; left: 16dp; right: 12dp; top: 48dp; bottom: 12dp; overflow-y: auto; overflow-x: hidden; }
#ground-storage { width: 288dp; }
#ground-scroll scrollbarvertical { width: 8dp; margin-left: 8dp; }
#ground-scroll scrollbarvertical slidertrack { background-color: #2b2d2f; }
#ground-scroll scrollbarvertical sliderbar { min-height: 20dp; background-color: #f5f6f280; }
#ground-scroll scrollbarvertical sliderarrowdec, #ground-scroll scrollbarvertical sliderarrowinc { height: 0dp; }
