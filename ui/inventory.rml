<rml>
<head><title>Inventory</title><link type="text/template" href="loadout.rml" /></head>
<body template="loadout" class="loadout inventory">
    <div id="body-storage" class="panel main-panel">
        <div class="panel-heading">BODY STORAGE</div><div id="body-storage-count" class="panel-meta"></div>
        <div class="body-placeholder"></div><div class="body-placeholder-label">BODY<br/>REFERENCE</div>
        <div id="body-storage-slots" class="storage-area"></div>
    </div>
    <div id="backpack" class="panel main-panel">
        <div id="backpack-name" class="panel-heading">BACKPACK</div><div id="backpack-size" class="panel-meta backpack-size"></div>
        <div id="backpack-storage" class="storage-area"></div>
        <div id="backpack-access" class="backpack-access"></div>
        <div id="backpack-caption" class="backpack-caption"></div>
    </div>
    <div id="item-details" class="panel main-panel details-panel">
        <div class="panel-heading">ITEM DETAILS</div>
        <div class="detail-square unselected"></div><div id="inventory-item-name" class="detail-name">No item selected</div><div id="inventory-help" class="detail-subtitle">Drag / Wheel: 90° / Right-click: cancel</div>
        <div class="detail-fields">
            <div class="detail-field"><div class="field-label">TYPE</div><div id="inventory-type" class="field-value">—</div></div>
            <div class="detail-field"><div class="field-label">SIZE</div><div id="inventory-size" class="field-value">—</div></div>
            <div class="detail-field"><div class="field-label">TAGS</div><div id="inventory-tags" class="field-value">—</div></div>
            <div class="detail-field"><div class="field-label">CURRENT LOCATION</div><div id="inventory-current-location" class="field-value">—</div></div>
            <div class="detail-field"><div class="field-label">ACCESS TIME</div><div id="inventory-access-time" class="field-value">—</div></div>
        </div>
    </div>
</body>
</rml>
