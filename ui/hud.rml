<rml>
<head>
    <title>Game HUD</title>
    <link type="text/rcss" href="hud.rcss" />
    <link type="text/rcss" href="equipment-drawer.rcss" />
    <link type="text/rcss" href="command-wheel.rcss" />
    <link type="text/rcss" href="palette.rcss" />
    <link type="text/rcss" href="hud-icons.rcss" />
</head>
<body class="gameplay">
    <div id="compass">
        <div id="compass-scale"></div>
        <div class="compass-pointer hud-icon"></div>
        <div class="compass-center"></div>
        <div id="heading">000°</div>
    </div>
    <div id="navigation">
        <div id="coordinates"><div id="north-coordinate">N 0 m</div><div id="east-coordinate">E 0 m</div></div>
        <minimap id="minimap"><div id="player-marker" class="hud-icon"></div></minimap>
        <div id="map-caption" class="map-caption">NO MAP</div>
    </div>
    <div id="vitals">
        <div class="vital-row health">
            <div id="health-icon" class="hud-icon"></div><div class="vital-name">HEALTH <span id="health-value">--</span></div><div class="vital-track"><div id="health-fill"></div></div>
        </div>
        <div class="vital-row stamina">
            <div id="stamina-icon" class="hud-icon"></div><div class="vital-name">STAMINA <span id="stamina-value">--</span></div><div class="vital-track"><div id="stamina-fill"></div></div>
        </div>
        <div class="vital-row strain">
            <div id="strain-icon" class="hud-icon"></div><div class="vital-name">STRAIN <span id="strain-value">--</span></div><div class="vital-track"><div id="strain-fill"></div><div id="strain-limit"></div></div>
        </div>
    </div>
    <div id="status-strip">
        <div id="mode-status" class="status-item"><div id="mode-icon" class="hud-icon combat"></div><div id="mode">ITEM</div></div>
        <div id="movement-status" class="status-item"><div id="movement-icon" class="hud-icon stand"></div><div id="movement">STAND</div></div>
        <div id="speed-status" class="status-item"><div id="speed-icon" class="hud-icon"></div><div id="speed">0.0 km/h</div></div>
    </div>
    <div id="weapon">
        <div id="equipment">CONNECTING</div>
        <div id="weapon-icon" class="hud-icon"></div>
        <div class="weapon-divider"></div>
        <div class="ammo"><span id="loaded">--</span> / <span id="reserve">--</span></div>
    </div>
    <div id="prompt"></div>
    <div id="capture"></div>
    <div id="weapon-selection">
        <div id="selection-slots"></div>
        <div id="selection-hint" class="selection-hint">LEFT CLICK TO SELECT</div>
    </div>
    <div id="weapon-switch">
        <div class="switch-label"><span id="switch-label">SWITCHING WEAPON</span><span id="switch-countdown"></span></div>
        <div class="switch-track"><div id="switch-fill"></div></div>
    </div>
    <div id="signal-markers"></div>
    <div id="command-wheel">
        <div id="command-title" class="command-title">SIGNALS &amp; PAGES</div>
        <command-sector id="command-page-inventory" class="command-choice command-page" page="true" sector="0"><div class="page-caption"><div class="page-label">INVENTORY</div><div class="page-key">F1</div></div></command-sector>
        <command-sector id="command-page-skills" class="command-choice command-page" page="true" sector="1"><div class="page-caption"><div class="page-label">SKILLS</div><div class="page-key">F2</div></div></command-sector>
        <command-sector id="command-page-health" class="command-choice command-page" page="true" sector="2"><div class="page-caption"><div class="page-label">HEALTH</div><div class="page-key">F3</div></div></command-sector>
        <command-sector id="command-page-map" class="command-choice command-page" page="true" sector="3"><div class="page-caption"><div class="page-label">MAP</div><div class="page-key">F4</div></div></command-sector>
        <command-sector id="command-page-graphics" class="command-choice command-page" page="true" sector="4"><div class="page-caption"><div class="page-label">GRAPHICS</div><div class="page-key">F12</div></div></command-sector>
        <command-sector id="command-danger" class="command-choice" sector="0"><div class="command-caption"><div class="command-symbol">!</div><div class="command-label">DANGER</div></div></command-sector>
        <command-sector id="command-move" class="command-choice" sector="1"><div class="command-caption"><div class="command-symbol">→</div><div class="command-label">MOVE THERE</div></div></command-sector>
        <command-sector id="command-backup" class="command-choice" sector="2"><div class="command-caption"><div class="command-symbol">+</div><div class="command-label">BACKUP</div></div></command-sector>
        <div id="command-center"><div class="command-key">MMB</div><div id="command-center-label">CANCEL</div></div>
        <div id="command-cursor"></div>
        <div id="command-hint" class="command-hint">HOLD MIDDLE MOUSE · SELECT · RELEASE TO SEND / OPEN</div>
        <div id="command-cancel-hint" class="command-cancel-hint">RETURN TO CENTER OR PRESS ESC TO CANCEL</div>
    </div>
    <div id="damage-feedback">
        <div class="damage-edge top-edge"></div><div class="damage-edge bottom-edge"></div>
        <div class="damage-edge left-edge"></div><div class="damage-edge right-edge"></div>
    </div>
    <div id="equipment-drawer">
        <div id="equipment-tab"><div>I<br/>n<br/>v<br/>e<br/>n<br/>t<br/>o<br/>r<br/>y</div></div>
        <div id="equipment-panel">
            <div class="equipment-title">EQUIPMENT <span>TAB · CURSOR</span></div>
            <div id="equipment-list"></div>
            <div id="equipment-status"></div>
        </div>
    </div>
</body>
</rml>
