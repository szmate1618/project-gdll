<rml>
<head>
    <title>Game HUD</title>
    <link type="text/rcss" href="hud.rcss" />
    <link type="text/rcss" href="palette.rcss" />
</head>
<body>
    <div id="compass">
        <div id="compass-scale"></div>
        <div class="compass-pointer"></div>
        <div class="compass-center"></div>
        <div id="heading">000°</div>
    </div>
    <div id="navigation">
        <div id="coordinates"><div id="north-coordinate">N 0 m</div><div id="east-coordinate">E 0 m</div></div>
        <minimap id="minimap"><div id="player-placeholder"></div></minimap>
        <div id="map-caption" class="map-caption">NO MAP</div>
    </div>
    <div id="vitals">
        <div class="vital-row health">
            <div class="square"></div><div class="vital-name">HEALTH <span>--</span></div><div class="vital-track"></div>
        </div>
        <div class="vital-row stamina">
            <div class="square"></div><div class="vital-name">STAMINA <span>--</span></div><div class="vital-track"></div>
        </div>
        <div class="vital-row weariness">
            <div class="square"></div><div class="vital-name">WEARINESS <span>--</span></div><div class="vital-track"></div>
        </div>
    </div>
    <div id="status-strip">
        <div id="mode-status" class="status-item"><div class="square"></div><div id="mode">COMBAT</div></div>
        <div id="movement-status" class="status-item"><div class="square"></div><div id="movement">STAND</div></div>
        <div id="speed-status" class="status-item"><div class="square"></div><div id="speed">0.0 km/h</div></div>
    </div>
    <div id="weapon">
        <div id="equipment">CONNECTING</div>
        <div id="weapon-placeholder" class="square"></div>
        <div class="weapon-divider"></div>
        <div class="ammo"><span id="loaded">--</span> / <span id="reserve">--</span></div>
    </div>
    <div id="prompt"></div>
    <div id="capture"></div>
    <div id="weapon-selection">
        <div id="selection-slots"></div>
        <div class="selection-hint">LEFT CLICK TO SELECT</div>
    </div>
    <div id="weapon-switch">
        <div class="switch-label">SWITCHING WEAPON <span id="switch-countdown"></span></div>
        <div class="switch-track"><div id="switch-fill"></div></div>
    </div>
</body>
</rml>
