body {
    width: 100%; height: 100%; margin: 0;
    font-family: hud-system; font-weight: normal; font-size: 14dp;
    pointer-events: none;
}
div { display: block; }
.square { width: 22dp; height: 22dp; }
#compass { position: absolute; top: 30dp; left: 50%; margin-left: -222dp; width: 444dp; height: 52dp; }
#compass-scale { position: absolute; top: 10dp; width: 444dp; height: 40dp; overflow: hidden; clip: always; }
.compass-rule { position: absolute; top: 12dp; width: 444dp; height: 1dp; }
.compass-tick { position: absolute; top: 4dp; width: 1dp; height: 8dp; }
.compass-tick.major { top: 0dp; height: 17dp; }
.compass-label { position: absolute; top: 23dp; width: 44dp; margin-left: -22dp; text-align: center; font-size: 12dp; }
.compass-label.covered { visibility: hidden; }
.compass-pointer { position: absolute; left: 217.5dp; top: -1dp; width: 9dp; height: 9dp; }
.compass-center { position: absolute; left: 222dp; top: 7dp; width: 1dp; height: 16dp; }
#heading { position: absolute; top: 29dp; left: 188dp; width: 68dp; text-align: center; font-size: 17dp; }
#navigation { position: absolute; top: 29dp; right: 25dp; width: 212dp; height: 126dp; }
#coordinates { position: absolute; left: 0dp; top: 17dp; width: 97dp; font-size: 12dp; line-height: 20dp; }
#minimap { display: block; position: absolute; right: 0dp; top: 0dp; width: 108dp; height: 108dp; border-width: 1dp; }
#player-marker { position: absolute; left: 50dp; top: 50dp; width: 8dp; height: 8dp; }
.map-caption { position: absolute; right: 0dp; top: 114dp; width: 110dp; text-align: center; font-size: 9dp; }
#vitals { position: absolute; left: 34dp; bottom: 40dp; width: 260dp; height: 94dp; }
.vital-row { position: relative; height: 34dp; }
.vital-row .hud-icon { position: absolute; left: 0dp; top: 0dp; width: 21dp; height: 21dp; }
.vital-name { position: absolute; left: 38dp; top: -2dp; width: 222dp; font-size: 11dp; }
.vital-name span { float: right; }
.vital-track { position: absolute; left: 38dp; top: 15dp; width: 220dp; height: 7dp; border-width: 1dp; }
#health-fill { width: 0dp; height: 7dp; }
#damage-feedback { display: none; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; z-index: 20; }
.damaged #damage-feedback { display: block; }
.damage-edge { position: absolute; }
.top-edge, .bottom-edge { left: 0dp; width: 100%; height: 24dp; }
.top-edge { top: 0dp; }
.bottom-edge { bottom: 0dp; }
.left-edge, .right-edge { top: 24dp; bottom: 24dp; width: 24dp; }
.left-edge { left: 0dp; }
.right-edge { right: 0dp; }
#status-strip { position: absolute; left: 50%; bottom: 44dp; margin-left: -210dp; width: 434dp; height: 30dp; }
.status-item { position: absolute; top: 0dp; height: 28dp; }
.status-item .hud-icon { position: absolute; top: 2dp; left: 0dp; width: 22dp; height: 22dp; }
#mode-status { left: 0dp; width: 128dp; border-right-width: 1dp; }
#mode { position: absolute; left: 42dp; top: 5dp; font-size: 14dp; }
#movement-status { left: 158dp; width: 124dp; border-right-width: 1dp; }
#movement { position: absolute; left: 38dp; top: 5dp; font-size: 14dp; }
#speed-status { left: 310dp; width: 140dp; }
#speed { position: absolute; left: 41dp; top: 3dp; font-size: 18dp; white-space: nowrap; }
#weapon { position: absolute; right: 34dp; bottom: 43dp; width: 198dp; height: 65dp; }
#equipment { position: absolute; left: 0dp; top: 0dp; width: 198dp; font-size: 12dp; white-space: nowrap; overflow: hidden; }
#weapon-icon { position: absolute; left: 0dp; bottom: 0dp; width: 66dp; height: 44dp; }
.weapon-divider { position: absolute; left: 78dp; top: 30dp; width: 1dp; height: 32dp; }
.ammo { position: absolute; right: 0dp; top: 28dp; font-size: 26dp; white-space: nowrap; }
#prompt { position: absolute; bottom: 110dp; left: 25%; width: 50%; text-align: center; font-size: 13dp; }
#capture { position: absolute; bottom: 18dp; left: 25%; width: 50%; text-align: center; font-size: 10dp; }
#weapon-selection { display: none; position: absolute; left: 24dp; top: 24dp; width: 346dp; height: 94dp; }
.selecting #weapon-selection { display: block; }
#selection-slots { position: relative; width: 346dp; height: 74dp; }
.selection-slot { position: absolute; top: 0dp; width: 22dp; height: 30dp; box-sizing: border-box; border-width: 1dp; }
.selection-slot.selected { width: 112dp; height: 74dp; }
.selection-marker { display: none; position: absolute; left: 8dp; bottom: 0dp; width: 20dp; height: 2dp; }
.selected .selection-marker { display: block; }
.selection-key { position: absolute; left: 0dp; top: 4dp; width: 20dp; text-align: center; font-size: 10dp; }
.selected .selection-key { left: 6dp; font-size: 11dp; }
.selection-icon { position: absolute; left: 4dp; top: 15dp; width: 14dp; height: 14dp; }
.selected .selection-icon { left: 6dp; top: 30dp; width: 24dp; height: 24dp; }
.selection-name { display: none; }
.selected .selection-name { display: block; position: absolute; left: 34dp; right: 7dp; top: 28dp; font-size: 11dp; line-height: 14dp; }
.empty .selection-icon { display: none; }
.empty .selection-name { left: 8dp; }
.selected.empty .selection-name { top: 30dp; }
.selection-hint { position: absolute; top: 82dp; width: 346dp; font-size: 8dp; letter-spacing: 1dp; }
#weapon-switch { display: none; position: absolute; bottom: 155dp; left: 50%; margin-left: -160dp; width: 320dp; height: 36dp; }
/* Keep progress below the enlarged wheel's two instruction lines. */
.commanding #weapon-switch { bottom: 110dp; }
.switching #weapon-switch { display: block; }
.switch-label { font-size: 10dp; letter-spacing: 1dp; }
#switch-countdown { float: right; }
.switch-track { position: absolute; top: 23dp; width: 318dp; height: 6dp; border-width: 1dp; }
#switch-fill { height: 6dp; }
