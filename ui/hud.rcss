body {
    width: 100%; height: 100%; margin: 0;
    font-family: hud-system; font-weight: normal; font-size: 14dp;
    color: #f5f6f2; pointer-events: none;
}
div { display: block; }
.square { width: 22dp; height: 22dp; }
#compass { position: absolute; top: 30dp; left: 50%; margin-left: -222dp; width: 444dp; height: 52dp; }
#compass-scale { position: absolute; top: 10dp; width: 444dp; height: 40dp; overflow: hidden; clip: always; }
.compass-rule { position: absolute; top: 12dp; width: 444dp; height: 1dp; background-color: #f5f6f2b0; }
.compass-tick { position: absolute; top: 4dp; width: 1dp; height: 8dp; background-color: #f5f6f2b0; }
.compass-tick.major { top: 0dp; height: 17dp; }
.compass-label { position: absolute; top: 23dp; width: 44dp; margin-left: -22dp; text-align: center; font-size: 12dp; }
.compass-label.covered { visibility: hidden; }
.compass-pointer { position: absolute; left: 220dp; top: 0dp; width: 5dp; height: 5dp; background-color: #f5f6f2; }
.compass-center { position: absolute; left: 222dp; top: 7dp; width: 1dp; height: 16dp; background-color: #f5f6f2; }
#heading { position: absolute; top: 29dp; left: 188dp; width: 68dp; text-align: center; font-size: 17dp; }
#navigation { position: absolute; top: 29dp; right: 25dp; width: 212dp; height: 126dp; }
#coordinates { position: absolute; left: 0dp; top: 17dp; width: 97dp; font-size: 12dp; line-height: 20dp; }
#map-placeholder { position: absolute; right: 0dp; top: 0dp; width: 108dp; height: 108dp; background-color: #3a5144; border: 1dp #f5f6f299; }
#player-placeholder { position: absolute; left: 51dp; top: 51dp; width: 6dp; height: 6dp; background-color: #f5f6f2; }
.map-caption { position: absolute; right: 0dp; top: 114dp; width: 110dp; text-align: center; font-size: 9dp; color: #f5f6f299; }
#vitals { position: absolute; left: 34dp; bottom: 40dp; width: 260dp; height: 94dp; }
.vital-row { position: relative; height: 34dp; }
.vital-row .square { position: absolute; left: 0dp; top: 0dp; width: 21dp; height: 21dp; }
.vital-name { position: absolute; left: 38dp; top: -2dp; width: 222dp; font-size: 11dp; }
.vital-name span { float: right; color: #f5f6f299; }
.vital-track { position: absolute; left: 38dp; top: 15dp; width: 220dp; height: 7dp; border: 1dp #f5f6f299; }
.health .square { background-color: #ec6962; }
.stamina .square { background-color: #59c49c; }
.weariness .square { background-color: #e7cd65; }
.health .vital-track { background-color: #ec69622e; }
.stamina .vital-track { background-color: #59c49c2e; }
.weariness .vital-track { background-color: #e7cd652e; }
#status-strip { position: absolute; left: 50%; bottom: 44dp; margin-left: -210dp; width: 434dp; height: 30dp; }
.status-item { position: absolute; top: 0dp; height: 28dp; }
.status-item .square { position: absolute; top: 2dp; left: 0dp; }
#mode-status { left: 0dp; width: 128dp; border-right: 1dp #f5f6f299; }
#mode-status .square { background-color: #f5f6f2; }
#mode { position: absolute; left: 42dp; top: 5dp; font-size: 14dp; }
#movement-status { left: 158dp; width: 124dp; border-right: 1dp #f5f6f299; }
#movement-status .square { background-color: #f5f6f2; }
#movement { position: absolute; left: 38dp; top: 5dp; font-size: 14dp; }
#speed-status { left: 310dp; width: 140dp; }
#speed-status .square { background-color: #f5f6f2; }
#speed { position: absolute; left: 41dp; top: 3dp; font-size: 18dp; white-space: nowrap; }
#weapon { position: absolute; right: 34dp; bottom: 43dp; width: 198dp; height: 65dp; }
#equipment { position: absolute; left: 0dp; top: 0dp; width: 198dp; font-size: 12dp; white-space: nowrap; overflow: hidden; }
#weapon-placeholder { position: absolute; left: 3dp; bottom: 5dp; width: 28dp; height: 28dp; background-color: #f5f6f2; }
.weapon-divider { position: absolute; left: 78dp; top: 30dp; width: 1dp; height: 32dp; background-color: #f5f6f299; }
.ammo { position: absolute; right: 0dp; top: 28dp; font-size: 26dp; white-space: nowrap; }
.fists #weapon-placeholder { background-color: #b29a85; }
.smg #weapon-placeholder { background-color: #889dba; }
.shotgun #weapon-placeholder { background-color: #bd9c73; }
.sniper #weapon-placeholder { background-color: #93a88a; }
.grenade #weapon-placeholder { background-color: #b3ae72; }
.unconfirmed #weapon-placeholder { background-color: #898d8c; }
#prompt { position: absolute; bottom: 110dp; left: 25%; width: 50%; text-align: center; font-size: 13dp; }
#capture { position: absolute; bottom: 18dp; left: 25%; width: 50%; text-align: center; font-size: 10dp; color: #f5f6f299; }
