+// A mesh section can end on an edge that continues in a different mesh.
+// Source adjacency marks that edge flat before either shape is attached.
+static bool b3IsSmoothTriangleFeature( b3TriangleFeature feature, int flags )
+{
+	// Same-mesh edge handling already has neighboring face witnesses. Only
+	// externally restored adjacency needs this cross-mesh correction.
+	if ( ( flags & b3_externalAdjacency ) == 0 ) return false;
+	int required = 0;
+	switch ( feature )
+	{
+		case b3_featureEdge1: required = b3_flatEdge1; break;
+		case b3_featureEdge2: required = b3_flatEdge2; break;
+		case b3_featureEdge3: required = b3_flatEdge3; break;
+		case b3_featureVertex1:
+			if ( ( flags & b3_smoothVertexFans ) == 0 ) return false;
+			required = b3_flatEdge1 | b3_flatEdge3;
+			break;
+		case b3_featureVertex2:
+			if ( ( flags & b3_smoothVertexFans ) == 0 ) return false;
+			required = b3_flatEdge1 | b3_flatEdge2;
+			break;
+		case b3_featureVertex3:
+			if ( ( flags & b3_smoothVertexFans ) == 0 ) return false;
+			required = b3_flatEdge2 | b3_flatEdge3;
+			break;
+		default:
+			return false;
+	}
+	return ( flags & required ) == required;
+}
