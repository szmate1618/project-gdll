+static void b3ProjectSmoothTriangleFeature( b3LocalManifold* manifold, b3Vec3 trianglePoint, const b3Shape* shape )
+{
+	const b3Vec3 normal = manifold->triangleNormal;
+	const b3Vec3 oldNormal = manifold->normal;
+	for ( int i = 0; i < manifold->pointCount; ++i )
+	{
+		b3LocalManifoldPoint* point = manifold->points + i;
+		// The stored point is the midpoint of the two witness points. Recover
+		// the shape-side witness before projecting onto the continuing plane.
+		b3Vec3 surface = b3MulAdd( point->point, 0.5f * point->separation, oldNormal );
+		if ( shape->type == b3_sphereShape || shape->type == b3_capsuleShape )
+		{
+			const float radius = shape->type == b3_sphereShape ? shape->sphere.radius : shape->capsule.radius;
+			const b3Vec3 center = shape->type == b3_sphereShape ? shape->sphere.center :
+				b3MulAdd( surface, radius, oldNormal );
+			const float offset = b3Dot( normal, b3Sub( center, trianglePoint ) );
+			point->point = b3MulSub( center, 0.5f * ( radius + offset ), normal );
+			point->separation = offset - radius;
+			if ( shape->type == b3_sphereShape ) manifold->squaredDistance = offset * offset;
