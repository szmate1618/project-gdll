+bool b3SetMeshEdgeFlags( b3MeshData* mesh, const uint8_t* flags, int triangleCount )
+{
+	if ( mesh == NULL || flags == NULL || mesh->version != B3_MESH_VERSION || triangleCount != mesh->triangleCount )
+	{
+		return false;
+	}
+	for ( int i = 0; i < triangleCount; ++i )
+	{
+		if ( ( flags[i] & ~( b3_allFlatEdges | b3_smoothVertexFans | b3_externalAdjacency ) ) != 0 ) return false;
+		if ( ( flags[i] & b3_externalAdjacency ) != 0 &&
+			 ( flags[i] & b3_flatEdge1 ) != b3_flatEdge1 &&
+			 ( flags[i] & b3_flatEdge2 ) != b3_flatEdge2 &&
+			 ( flags[i] & b3_flatEdge3 ) != b3_flatEdge3 ) return false;
+	}
+	memcpy( b3GetMeshFlagsWrite( mesh ), flags, triangleCount * sizeof( uint8_t ) );
+	mesh->hash = 0;
+	mesh->hash = b3Hash64NonZero( (uint8_t*)mesh, mesh->byteCount );
+	B3_VALIDATE( b3IsConsistent( mesh ) );
+	return true;
 }
 
