+// Project each tire's body-local axle into the contact plane. The axle is
+// invariant under wheel spin, but follows steering, camber and body rotation.
+static void b3DirectionalFrictionBasis( const b3Contact* contact, b3Vec3 normal,
+	b3Vec3* tangent1, b3Vec3* tangent2, float* friction1, float* friction2 )
+{
+	*friction1 = contact->friction;
+	*friction2 = contact->perpendicularFriction;
+	*tangent1 = b3Perp( normal );
+	if ( b3LengthSquared( contact->frictionAxle ) == 0.0f )
+	{
+		*friction2 = *friction1;
+	}
+	else
+	{
+		b3Vec3 rolling = b3Cross( normal, contact->frictionAxle );
+		if ( b3LengthSquared( rolling ) > 1.0e-8f ) *tangent1 = b3Normalize( rolling );
+		else *friction1 = *friction2; // A tire on its side has no rolling tangent.
+	}
+	*tangent2 = b3Cross( *tangent1, normal );
+}
+
+// One combined grip budget, expressed as an ellipse in the two tangents.
+static b3Vec2 b3ClampFrictionEllipse( b3Vec2 impulse, float limit1, float limit2 )
+{
+	if ( limit1 <= 0.0f ) impulse.x = 0.0f;
+	if ( limit2 <= 0.0f ) impulse.y = 0.0f;
+	float x = limit1 > 0.0f ? impulse.x / limit1 : 0.0f;
+	float y = limit2 > 0.0f ? impulse.y / limit2 : 0.0f;
+	float lengthSquared = x * x + y * y;
+	if ( lengthSquared > 1.0f )
+	{
+		float scale = 1.0f / sqrtf( lengthSquared );
+		impulse.x *= scale;
+		impulse.y *= scale;
+	}
+	return impulse;
+}
 
